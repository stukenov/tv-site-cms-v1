# Database Configuration
# For SQLite (default):
# DB_DRIVER=sqlite
# DB_DATABASE=sites/default/files/.ht.sqlite

# For MySQL/MariaDB:
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=your_database_name
# DB_USERNAME=your_database_user
# DB_PASSWORD=your_database_password
# DB_PREFIX=

# Drupal Settings
# Generate a random hash for config sync directory
# CONFIG_SYNC_DIRECTORY=sites/default/files/config_RANDOM_HASH/sync

# Site Settings
# SITE_NAME=TV Site
# SITE_MAIL=admin@example.com
# ACCOUNT_MAIL=admin@example.com

# Trusted Host Patterns (for production)
# TRUSTED_HOST_PATTERNS=^example\.com$,^www\.example\.com$
