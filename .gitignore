# Ignore Drupal core
/web/core/

# Ignore contributed modules and themes
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/

# Ignore uploaded files
/web/sites/default/files/

# Ignore configuration sync directory (contains generated config)
/web/sites/default/files/config_*/

# Ignore settings files with credentials
/web/sites/default/settings.php
/web/sites/default/settings.local.php
/web/sites/default/services.yml

# Ignore vendor directory (managed by Composer)
/vendor/

# Ignore Composer lock file (optional, but recommended for projects)
# Uncomment the line below if you want to commit composer.lock
# /composer.lock

# Ignore node modules
/node_modules/

# Ignore build artifacts
*.sass-cache
*.css.map
*.scss.map

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE files
.idea/
.vscode/
*.sublime-*

# Ignore backup files
*.bak
*.backup
*~

# Ignore environment files
.env
.env.local
